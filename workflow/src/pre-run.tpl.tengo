self := import("@platforma-sdk/workflow-tengo:workflow")
monetization := import("@platforma-sdk/workflow-tengo:exec.monetization")


self.body(func(args) {
	mnz := monetization.builder(args.productKey).
		setDate(args.__mnzDate).
		build()

	return {
		outputs: {
			mnzInfo: mnz
			},
		exports: {}
	}
})
